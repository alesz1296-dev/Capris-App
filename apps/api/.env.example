PORT=4000
NODE_ENV=development

# Prefer the repo-root `.env` as the source of truth for local development.
# This file is optional and only for API-local overrides when truly needed.
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/capris_app?schema=public

JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DEFAULT_REGISTRATION_ORGANIZATION_ID=org_capris
CAPRIS_QA_PASSWORD=replace-only-for-local-role-seeding

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MEDIA_URL_SIGNING_SECRET=replace-with-local-media-signing-secret
MEDIA_URL_TTL_SECONDS=900
METRICS_BEARER_TOKEN=

S3_BUCKET=capris-local
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

GOOGLE_CLIENT_ID=

POSTMARK_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
DEFAULT_FROM_EMAIL=
