PORT=4000
NODE_ENV=development

# Prefer the repo-root `.env` as the source of truth for local development.
# This file is optional and only for API-local overrides when truly needed.
DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DEFAULT_REGISTRATION_ORGANIZATION_ID=org_capris
CAPRIS_QA_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MEDIA_URL_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=900
METRICS_BEARER_TOKEN=

OBJECT_STORAGE_DRIVER=local
S3_BUCKET=capris-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=capris_local_minio
S3_SECRET_ACCESS_KEY=

GOOGLE_CLIENT_ID=

POSTMARK_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
DEFAULT_FROM_EMAIL=
