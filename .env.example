# Shared local container/dev defaults.
# Copy the values you need into untracked local env files.

APP_TIMEZONE=America/Costa_Rica

POSTGRES_DB=capris_app
POSTGRES_USER=capris_local_user
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

API_PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://<db_user>:<db_password>@postgres:5432/capris_app?schema=public
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
MEDIA_URL_SIGNING_SECRET=replace-with-local-media-signing-secret
GOOGLE_CLIENT_ID=local-google-client-id
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=local-google-client-id
