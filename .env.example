# Shared local/container defaults.
# Copy the values you need into untracked local env files.
# DATABASE_URL is for host-local tools like `npm run dev:api`.
# DATABASE_URL_DOCKER is for containers inside Docker Compose.

APP_TIMEZONE=America/Costa_Rica

POSTGRES_DB=capris_app
POSTGRES_USER=capris_local_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

API_PORT=4000
WEB_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=
DATABASE_URL_DOCKER=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MEDIA_URL_SIGNING_SECRET=
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_DRIVER_DOCKER=s3
S3_BUCKET=capris-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_ACCESS_KEY_ID=capris_local_minio
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=capris_local_minio
MINIO_ROOT_PASSWORD=
GOOGLE_CLIENT_ID=local-google-client-id
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=local-google-client-id
