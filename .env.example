# Shared local/container defaults.
# Copy the values you need into untracked local env files.
# DATABASE_URL is for host-local tools like `npm run dev:api`.
# DATABASE_URL_DOCKER is for containers inside Docker Compose.

APP_TIMEZONE=America/Costa_Rica

POSTGRES_DB=capris_app
POSTGRES_USER=capris_local_user
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

API_PORT=4000
WEB_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/capris_app?schema=public
DATABASE_URL_DOCKER=postgresql://<db_user>:<db_password>@postgres:5432/capris_app?schema=public
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
MEDIA_URL_SIGNING_SECRET=replace-with-local-media-signing-secret
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_DRIVER_DOCKER=s3
S3_BUCKET=capris-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_ACCESS_KEY_ID=capris_local_minio
S3_SECRET_ACCESS_KEY=change-me-local-minio-secret
MINIO_ROOT_USER=capris_local_minio
MINIO_ROOT_PASSWORD=change-me-local-minio-secret
GOOGLE_CLIENT_ID=local-google-client-id
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=local-google-client-id
